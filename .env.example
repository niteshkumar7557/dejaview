# Copy to .env and fill in the real values. Never commit .env.
# Every secret lives here or in the deployment/GitHub secrets, never in the repo.

# Postgres
DATABASE_URL=postgres://dejaview:dejaview@localhost:5432/dejaview

# Ollama on the team laptop (the models stay on our own machine)
LLM_BASE_URL=
LLM_API_TOKEN=
TRIAGE_MODEL=qwen3.5:4b
EXTRACT_MODEL=qwen3.5:9b
# live | record | replay   (CI uses replay)
LLM_MODE=replay

# GitHub REST API. Optional: raises the rate limit from 60 to 5000 requests per hour.
GITHUB_TOKEN=

# The API token the GitHub Action uses to call POST /api/pr-check
DEJAVIEW_API_TOKEN=

# Where the blobless CPython clone lives (Ansh's part)
CPYTHON_DIR=

# The web app talks to the API through this
NEXT_PUBLIC_API_URL=

# Where the dashboard lives, so the PR comment can link to a decision.
# Empty until it is deployed. Locally: http://localhost:3100
DASHBOARD_URL=
