{
  "name": "dejaview",
  "version": "0.1.0",
  "private": true,
  "description": "DejaView: recover the decisions nobody wrote down. Extracts decisions, rejected alternatives and reasons from open-source discussions and links them to code.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:conventions": "tsx scripts/check-conventions.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
